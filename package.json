{
  "name": "patient-funnel-manager",
  "version": "5.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "bundle:client": "node scripts/bundle-frontend.cjs",
    "build": "npm run build:tw && npm run bundle:client && vite build && node scripts/stamp-sw.cjs",
    "preview": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "deploy": "npm run build && wrangler pages deploy dist",
    "dev:sandbox": "wrangler pages dev dist --d1=pfm-production --local --ip 0.0.0.0 --port 3000",
    "build:tw": "tailwindcss -c tailwind.config.cjs -i tailwind.input.css -o public/static/tailwind.css --minify"
  },
  "dependencies": {
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250313.0",
    "@hono/vite-cloudflare-pages": "^0.4.2",
    "tailwindcss": "^3.4.17",
    "terser": "^5.46.1",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "wrangler": "^3.114.0"
  }
}
