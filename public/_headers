# ─── v5.7.1 슈퍼최적화: 정적 자산 캐시 전략 ───────────────────
# ⚠️ 파일명에 콘텐츠 해시가 없으므로 immutable 금지.
#    max-age=3600 + stale-while-revalidate 로 재방문 로딩을 즉시화하되,
#    배포 후 최대 1시간 내 자연 갱신. SW(stamp-sw 버전 캐시)가 별도로
#    정밀한 캐시 버스팅을 담당한다.

/static/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# 서비스워커는 항상 신선해야 배포 감지가 됨 (루트 /sw.js 는 워커가 재서빙)
/static/sw.js
  ! Cache-Control
  Cache-Control: no-cache

/sw.js
  ! Cache-Control
  Cache-Control: no-cache

# PWA 매니페스트: 짧게
/static/manifest.webmanifest
  ! Cache-Control
  Cache-Control: public, max-age=300
